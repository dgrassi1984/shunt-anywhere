#!/bin/bash
# Savings ledger summary: what bulk-read and code-write kept out of your
# expensive context, all time, per worker and per mode.
#
# Usage:
#   shunt-stats              summary
#   shunt-stats --last 20    the last delegations, raw JSONL
#   shunt-stats --json       the whole ledger, raw JSONL
#
# Opt out entirely by pointing SHUNT_STATS_FILE at /dev/null.

. "$(cd "$(dirname "$0")" && pwd)/lib/worker.sh"

case "${1:-}" in
  --json) cat "$SHUNT_STATS_FILE" 2>/dev/null; exit 0 ;;
  --last) tail -n "${2:-10}" "$SHUNT_STATS_FILE" 2>/dev/null; exit 0 ;;
  "") ;;
  *) echo "Usage: shunt-stats [--last N] [--json]" >&2; exit 2 ;;
esac

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: shunt-stats needs jq." >&2
  exit 1
fi
if [ ! -s "$SHUNT_STATS_FILE" ]; then
  echo "No delegations recorded yet."
  echo "Ledger: $SHUNT_STATS_FILE"
  exit 0
fi

# Tokens kept out of context by one delegation: what it carried away, minus
# what it brought back into the caller's context. Failures saved nothing, and
# an answer that went to disk (--target) counts in full.
summary=$(jq -rs '
  def saved: if (.rc == 0 and .output_tokens > 0)
             then (.input_tokens - (if (.returned == false) then 0 else .output_tokens end))
             else 0 end;
  [
    length,
    ([.[] | select(.rc == 0)] | length),
    ([.[] | select(.rc != 0)] | length),
    ([.[] | saved] | add // 0),
    (if length > 0 then (([.[] | saved] | add // 0) / length | floor) else 0 end),
    (.[-1].ts // "-"), (.[-1].host // "-"), (.[-1].worker // "-"),
    (.[-1].mode // "-"), (.[-1].input_tokens // 0),
    (.[-1].output_tokens // 0), (.[-1].secs // 0)
  ] | @tsv' "$SHUNT_STATS_FILE") || exit 1

IFS=$'\t' read -r calls ok failed total avg lts lhost lworker lmode lin lout lsecs <<< "$summary"

echo "shunt — $calls delegations ($ok ok, $failed failed)"
echo "tokens kept out of context: $total (avg $avg per call)"
echo "ledger: $SHUNT_STATS_FILE"

# Per worker: calls and kept-out tokens, busiest first.
while IFS=$'\t' read -r w n s; do
  [ -n "$w" ] && echo "  worker $w: $n calls, $s tk"
done < <(jq -rs '
  def saved: if (.rc == 0 and .output_tokens > 0)
             then (.input_tokens - (if (.returned == false) then 0 else .output_tokens end))
             else 0 end;
  [.[] | {w: .worker, s: saved}]
  | group_by(.w)
  | map([.[0].w, length, (map(.s) | add // 0)])
  | sort_by(-(.[2]))
  | .[] | @tsv' "$SHUNT_STATS_FILE" 2>/dev/null)

# Per mode: calls and kept-out tokens.
while IFS=$'\t' read -r m n s; do
  [ -n "$m" ] && echo "  mode $m: $n calls, $s tk"
done < <(jq -rs '
  def saved: if (.rc == 0 and .output_tokens > 0)
             then (.input_tokens - (if (.returned == false) then 0 else .output_tokens end))
             else 0 end;
  [.[] | {m: .mode, s: saved}]
  | group_by(.m)
  | map([.[0].m, length, (map(.s) | add // 0)])
  | sort_by(-(.[2]))
  | .[] | @tsv' "$SHUNT_STATS_FILE" 2>/dev/null)

echo "last: $lts  $lhost/$lworker  $lmode  $lin->$lout tk in ${lsecs}s"
