#!/bin/bash
# Savings ledger summary: what bulk-read and code-write kept out of your
# expensive context — per harness, per triggering function, and the gate
# blocks that never became delegations.
#
# Usage:
#   shunt-stats              summary
#   shunt-stats --last 20    the last delegations, raw JSONL
#   shunt-stats --json       the whole ledger, raw JSONL
#
# Opt out entirely by pointing SHUNT_STATS_FILE at /dev/null.

. "$(cd "$(dirname "$0")" && pwd)/lib/worker.sh"

case "${1:-}" in
  --json) cat "$SHUNT_STATS_FILE" 2>/dev/null; exit 0 ;;
  --last) tail -n "${2:-10}" "$SHUNT_STATS_FILE" 2>/dev/null; exit 0 ;;
  "") ;;
  *) echo "Usage: shunt-stats [--last N] [--json]" >&2; exit 2 ;;
esac

if ! command -v jq >/dev/null 2>&1; then
  echo "Error: shunt-stats needs jq." >&2
  exit 1
fi
if [ ! -s "$SHUNT_STATS_FILE" ]; then
  echo "No delegations recorded yet."
  echo "Ledger: $SHUNT_STATS_FILE"
  exit 0
fi

# Shared jq preamble: a row is a delegation unless it says kind "gate" (older
# rows predate the field); saved = carried away minus brought back, a
# disk-bound answer counts in full, failures and empty answers count zero.
DE='def del: select((.kind // "delegation") == "delegation");
    def saved: if (.rc == 0 and .output_tokens > 0)
               then (.input_tokens - (if (.returned == false) then 0 else .output_tokens end))
               else 0 end;'

summary=$(jq -rs "$DE"'
  ([.[] | del] | length > 0) as $any
  | [
      ([.[] | del] | length),
      ([.[] | del | select(.rc == 0)] | length),
      ([.[] | del | select(.rc != 0)] | length),
      ([.[] | del | saved] | add // 0),
      (if $any then (([.[] | del | saved] | add // 0) / ([.[] | del] | length) | floor) else 0 end),
      ([.[] | select(.kind == "gate")] | length),
      ([.[] | del][-1].ts // "-"),
      ([.[] | del][-1].host // "-"),
      ([.[] | del][-1].worker // "-"),
      ([.[] | del][-1].mode // "-"),
      (([.[] | del][-1].via // "direct") | tostring),
      ([.[] | del][-1].input_tokens // 0),
      ([.[] | del][-1].output_tokens // 0),
      ([.[] | del][-1].secs // 0)
    ] | @tsv' "$SHUNT_STATS_FILE") || exit 1

IFS=$'\t' read -r calls ok failed total avg gates lts lhost lworker lmode lvia lin lout lsecs <<< "$summary"

echo "shunt — $calls delegations ($ok ok, $failed failed) · $gates gate blocks"
echo "tokens kept out of context: $total (avg $avg per call)"
echo "ledger: $SHUNT_STATS_FILE"

# Any grouping over delegations: $1 = title, $2 = jq field expression.
group_section() {
  local title="$1" expr="$2"
  printf '%s\n' "$title"
  while IFS=$'\t' read -r v n s; do
    [ -n "$v" ] && printf '  %-14s %3d calls  %8s tk\n' "$v" "$n" "$s"
  done < <(jq -rs "$DE"'
    [.[] | del]
    | group_by('"$expr"')
    | map([(.[0] | ('"$expr"') | tostring), length, (map(saved) | add // 0)])
    | sort_by(-(.[2]))
    | .[] | @tsv' "$SHUNT_STATS_FILE" 2>/dev/null)
}

group_section "by harness" '.host'
group_section "by trigger" '(.via // "direct")'
group_section "by worker" '.worker'
group_section "by mode" '.mode'

# Gate blocks: which triggering function refused what. Refusals, not savings
# — the agent may delegate, do a targeted read, or nothing.
if [ "$gates" -gt 0 ]; then
  echo "gate blocks by hook (refusals, not savings)"
  while IFS=$'\t' read -r v n maxlines; do
    [ -n "$v" ] && printf '  %-16s %3d blocks  largest %s lines\n' "$v" "$n" "$maxlines"
  done < <(jq -rs '
    [.[] | select(.kind == "gate")]
    | group_by(.hook)
    | map([.[0].hook, length, (map(.lines) | max)])
    | sort_by(-(.[1]))
    | .[] | @tsv' "$SHUNT_STATS_FILE" 2>/dev/null)
fi

echo "last: $lts  $lhost/$lworker  $lmode via $lvia  $lin->$lout tk in ${lsecs}s"
