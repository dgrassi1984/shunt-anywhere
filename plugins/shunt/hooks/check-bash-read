#!/bin/bash
# Block shell commands that read a large file into context, and point at the
# bulk-read script. Catches cat/head/tail/less/more, which bypass a read-tool
# hook entirely — and on Codex this is the only gate there is, since Codex reads
# files through the shell rather than a Read tool.
#
# Derived from spotify/portal-ai-plugins plugins/shunt/hooks/check-bash-read
# (Apache-2.0). Changed: exit 2 + stderr instead of a decision envelope, a
# runnable command in the refusal, and a `bash -lc "…"` wrapper is unwrapped
# first because that is how Codex and Gemini hand a command to the shell.

MIN_LINES="${SHUNT_MIN_LINES:-350}"
case "$MIN_LINES" in ''|*[!0-9]*) MIN_LINES=350 ;; esac

BULK_READ="$(cd "$(dirname "$0")/../scripts" 2>/dev/null && pwd)/bulk-read"

input=$(cat)

if ! command -v jq >/dev/null 2>&1; then
  echo "shunt: jq not found, large-file gate disabled (apt install jq)" >&2
  exit 0
fi

# Hosts pass the command as a string, or as an argv array (Codex shell calls).
command=$(printf '%s' "$input" | jq -r '
  .tool_input.command // .tool_input.cmd // empty
  | if type == "array" then map(tostring) | join(" ") else tostring end')
[ -z "$command" ] && exit 0

# Unwrap one shell -c layer: `bash -lc "cat big.py"` must be read as `cat big.py`.
command=$(printf '%s' "$command" | sed -E "s/^[[:space:]]*(ba|z|k|da)?sh[[:space:]]+-[a-z]*c[[:space:]]+//")
command=$(printf '%s' "$command" | sed -E "s/^[\"']//; s/[\"']$//")

# Unwrap transparent rtk wrappers: `rtk proxy <cmd>` runs the command raw, so
# `rtk proxy cat big.py` is a whole-file read into context, and `rtk read
# <files>` is a filtered cat — the corpus still lands in context. An agent
# instructed to prefix rtk onto commands would otherwise slip a big read past
# the gate.
command=$(printf '%s' "$command" | sed -E "s/^[[:space:]]*rtk[[:space:]]+proxy[[:space:]]+//")
command=$(printf '%s' "$command" | sed -E "s/^[[:space:]]*rtk[[:space:]]+read([[:space:]])/cat\1/")

# Piped or redirected reads are targeted, not reads into context.
case "$command" in
  *\|*|*\>*) exit 0 ;;
esac

# Extract the first non-flag argument of a read command.
file_path=""
if printf '%s' "$command" | grep -qE '^(cat|head|tail|less|more)[[:space:]]'; then
  args=$(printf '%s' "$command" | sed -E 's/^(cat|head|tail|less|more)[[:space:]]+//')
  for arg in $args; do
    case "$arg" in
      -*) continue ;;
      *)  file_path=$(printf '%s' "$arg" | tr -d '"'"'"); break ;;
    esac
  done
fi

[ -z "$file_path" ] && exit 0
[ -f "$file_path" ] || exit 0

lines=$(wc -l < "$file_path" 2>/dev/null | tr -d ' ')
case "$lines" in ''|*[!0-9]*) exit 0 ;; esac
[ "$lines" -le "$MIN_LINES" ] && exit 0

{
  echo "File is ${lines} lines (threshold: ${MIN_LINES}). Reading that into context is what"
  echo "this plugin exists to avoid. Delegate it to a cheap worker model instead:"
  echo ""
  echo "  ${BULK_READ} --question \"<what you need to know>\" --paths \"${file_path}\""
  echo ""
  echo "The file goes to the worker, never into your context. If you need exact content"
  echo "to make an edit, read just the section you need (sed -n '120,180p')."
} >&2
exit 2
