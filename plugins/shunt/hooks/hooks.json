{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/check-file-size\""
          }
        ]
      },
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:-.}}/hooks/check-bash-read\""
          }
        ]
      }
    ]
  }
}
