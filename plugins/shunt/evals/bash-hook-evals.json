{
  "skill_name": "shunt",
  "description": "Evals for the check-bash-read PreToolUse hook",
  "evals": [
    {
      "id": 1,
      "name": "cat-large-file",
      "input": {
        "tool_input": {
          "command": "cat {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "Plain cat on large file — should block"
    },
    {
      "id": 2,
      "name": "cat-small-file",
      "input": {
        "tool_input": {
          "command": "cat {{FIXTURES}}/small.txt"
        }
      },
      "fixture": {
        "lines": 100
      },
      "expected_decision": "allow",
      "reason": "Small file — not worth delegating"
    },
    {
      "id": 3,
      "name": "cat-with-flag",
      "input": {
        "tool_input": {
          "command": "cat -n {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "cat with -n flag — should still block"
    },
    {
      "id": 4,
      "name": "head-large-file",
      "input": {
        "tool_input": {
          "command": "head {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "head on large file — should block"
    },
    {
      "id": 5,
      "name": "head-with-count",
      "input": {
        "tool_input": {
          "command": "head -100 {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "head -100 — still a bulk read, block"
    },
    {
      "id": 6,
      "name": "tail-large-file",
      "input": {
        "tool_input": {
          "command": "tail {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "tail on large file — should block"
    },
    {
      "id": 7,
      "name": "less-large-file",
      "input": {
        "tool_input": {
          "command": "less {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "less on large file — should block"
    },
    {
      "id": 8,
      "name": "cat-pipe",
      "input": {
        "tool_input": {
          "command": "cat {{FIXTURES}}/large.txt | grep export"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "allow",
      "reason": "Piped command — targeted read"
    },
    {
      "id": 9,
      "name": "cat-redirect",
      "input": {
        "tool_input": {
          "command": "cat {{FIXTURES}}/large.txt > /tmp/out.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "allow",
      "reason": "Redirect — copying file, not reading into context"
    },
    {
      "id": 10,
      "name": "non-read-command",
      "input": {
        "tool_input": {
          "command": "git status"
        }
      },
      "fixture": null,
      "expected_decision": "allow",
      "reason": "Not a file read command"
    },
    {
      "id": 11,
      "name": "grep-command",
      "input": {
        "tool_input": {
          "command": "grep -n 'export' {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "allow",
      "reason": "grep is a targeted search — not caught"
    },
    {
      "id": 12,
      "name": "cat-quoted-path",
      "input": {
        "tool_input": {
          "command": "cat \"{{FIXTURES}}/large.txt\""
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "Quoted path — should still be caught"
    },
    {
      "id": 13,
      "name": "cat-nonexistent",
      "input": {
        "tool_input": {
          "command": "cat /tmp/shunt-does-not-exist.txt"
        }
      },
      "fixture": null,
      "expected_decision": "allow",
      "reason": "File doesn't exist — let Bash handle the error"
    },
    {
      "id": 14,
      "name": "empty-command",
      "input": {
        "tool_input": {
          "command": ""
        }
      },
      "fixture": null,
      "expected_decision": "allow",
      "reason": "Empty command — pass through"
    },
    {
      "id": 15,
      "name": "missing-command-field",
      "input": {
        "tool_input": {}
      },
      "fixture": null,
      "expected_decision": "allow",
      "reason": "No command field — pass through"
    },
    {
      "id": 16,
      "name": "more-large-file",
      "input": {
        "tool_input": {
          "command": "more {{FIXTURES}}/large.txt"
        }
      },
      "fixture": {
        "lines": 800
      },
      "expected_decision": "block",
      "reason": "more on large file — only regex-matched command without coverage"
    },
    {
      "id": 17,
      "name": "head-n-space-count",
      "input": {
        "tool_input": {
          "command": "head -n 5 {{FIXTURES}}/large.txt"
        }
      },
      "fixture": null,
      "expected_decision": "allow",
      "reason": "Parser bug: -n and 5 are separate args, 5 is treated as file path — file '5' won't exist so allow"
    },
    {
      "id": 18,
      "name": "bash-lc-wrapped-cat",
      "input": {
        "tool_input": {
          "command": "bash -lc \"cat {{FIXTURES}}/large.txt\""
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "expected_decision": "block",
      "reason": "Codex and Gemini hand the shell a `bash -lc` string — unwrap it before matching"
    },
    {
      "id": 19,
      "name": "sh-c-wrapped-cat",
      "input": {
        "tool_input": {
          "command": "sh -c 'cat {{FIXTURES}}/large.txt'"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "expected_decision": "block",
      "reason": "same wrapper, plain sh and single quotes"
    },
    {
      "id": 20,
      "name": "argv-array-command",
      "input": {
        "tool_input": {
          "command": [
            "cat",
            "{{FIXTURES}}/large.txt"
          ]
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "expected_decision": "block",
      "reason": "some hosts pass argv as an array, not a string"
    },
    {
      "id": 21,
      "name": "wrapped-pipe-allowed",
      "input": {
        "tool_input": {
          "command": "bash -lc \"cat {{FIXTURES}}/large.txt | head -5\""
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "expected_decision": "allow",
      "reason": "unwrapping must not lose the pipe that makes it targeted"
    },
    {
      "id": 22,
      "name": "sed-range-allowed",
      "input": {
        "tool_input": {
          "command": "sed -n '1,50p' {{FIXTURES}}/large.txt"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "expected_decision": "allow",
      "reason": "a line range is already a targeted read"
    },
    {
      "id": 23,
      "name": "cmd-key-fallback",
      "input": {
        "tool_input": {
          "cmd": "cat {{FIXTURES}}/large.txt"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "expected_decision": "block",
      "reason": "a host that names the field cmd is still gated"
    },
    {
      "id": 24,
      "name": "no-jq-fails-open",
      "input": {
        "tool_input": {
          "command": "cat {{FIXTURES}}/large.txt"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 1200
        }
      ],
      "env": {
        "PATH": "/nonexistent"
      },
      "expected_decision": "allow",
      "reason": "without jq the gate cannot parse its input: fail open and warn, never block everything"
    },
    {
      "id": 25,
      "name": "rtk-proxy-cat-large",
      "input": {
        "tool_input": {
          "command": "rtk proxy cat {{FIXTURES}}/large.txt"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 800
        }
      ],
      "expected_decision": "block",
      "reason": "rtk proxy runs the command raw, so a prefixed whole-file read is still a whole-file read"
    },
    {
      "id": 26,
      "name": "rtk-proxy-cat-small",
      "input": {
        "tool_input": {
          "command": "rtk proxy cat {{FIXTURES}}/small.txt"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/small.txt",
          "lines": 100
        }
      ],
      "expected_decision": "allow",
      "reason": "a small file through rtk proxy is not worth delegating"
    },
    {
      "id": 27,
      "name": "rtk-proxy-piped",
      "input": {
        "tool_input": {
          "command": "rtk proxy cat {{FIXTURES}}/large.txt | grep x"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 800
        }
      ],
      "expected_decision": "allow",
      "reason": "an rtk-prefixed piped read is targeted, not a read into context"
    },
    {
      "id": 28,
      "name": "rtk-read-large",
      "input": {
        "tool_input": {
          "command": "rtk read {{FIXTURES}}/large.txt"
        }
      },
      "fixtures": [
        {
          "path": "{{FIXTURES}}/large.txt",
          "lines": 800
        }
      ],
      "expected_decision": "block",
      "reason": "rtk read is a filtered cat: the corpus still lands in context, so it is gated"
    }
  ]
}
